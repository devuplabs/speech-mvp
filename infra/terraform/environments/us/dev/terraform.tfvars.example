# Copy to terraform.tfvars (gitignored). Create a separate US GCP project first.

project_id   = "REPLACE_US_DEV_PROJECT_ID"
region       = "us-central1"
jurisdiction = "us"
environment  = "dev"
name_prefix  = "sona"

gcs_bucket_force_destroy = true

db_tier                = "db-f1-micro"
db_disk_size_gb        = 10
db_high_availability   = false
db_deletion_protection = false
db_backup_enabled      = true
db_pitr_enabled        = true
