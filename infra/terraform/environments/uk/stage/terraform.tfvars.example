# Copy to terraform.tfvars (do not commit). Replace project_id with your stage GCP project.
project_id   = "your-sona-uk-stage-project-id"
region       = "europe-west2"
jurisdiction = "uk"
environment  = "stage"
name_prefix   = "sona"

gcs_bucket_force_destroy = false

db_tier                = "db-g1-small"
db_disk_size_gb        = 20
db_high_availability    = false
db_deletion_protection  = true
db_backup_enabled       = true
db_pitr_enabled         = true
