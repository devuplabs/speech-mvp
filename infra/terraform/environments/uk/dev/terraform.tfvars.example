# Copy to terraform.tfvars (gitignored) for local runs.

project_id   = "project-a625d19b-de99-48e9-9a9"
region       = "europe-west2"
jurisdiction = "uk"
environment  = "dev"
name_prefix  = "sona"

gcs_bucket_force_destroy = true

db_tier                = "db-f1-micro"
db_edition             = "ENTERPRISE" # required for db-f1-micro on POSTGRES_16 (API default is ENTERPRISE_PLUS)
db_disk_size_gb        = 10
db_high_availability   = false
db_deletion_protection = false
db_backup_enabled      = true
db_pitr_enabled        = true

# MVP phase 1: core only (VPC, Cloud SQL, KMS, GCS, Cloud Tasks, Artifact Registry).
inference_enabled = false

# Phase 2 — GKE + vLLM (ADR-003). Enable after core apply succeeds.
# inference_enabled = true
# inference_zone    = "europe-west2-b"
# model_gcs_prefix  = "gemma-3-27b-it"
# vllm_container_image = "europe-west2-docker.pkg.dev/project-a625d19b-de99-48e9-9a9/sona-sona/vllm-openai:latest"
# inference_gpu_machine_type    = "g2-standard-8"
# inference_node_pool_min_count = 1
# inference_node_pool_max_count = 1
# inference_deletion_protection = false

# ---- First AI loop — Vertex AI Gemini 2.5 (europe-west2, OpenAI-compatible) ----
# Bypasses the self-hosted vLLM path above. Same GCP project, no new vendor.
# Uncomment the four lines below, fill in the project id, merge, and the
# sona-terraform-dev-apply trigger will:
#   - point INFERENCE_OPENAI_BASE_URL at Vertex AI
#   - set LLM_MODEL to Gemini 2.5 Flash (cheap; swap to gemini-2.5-pro for quality)
#   - keep LLM_ENABLED_KINDS unset so only prep_brief uses the LLM (the first loop)
#   - grant roles/aiplatform.user to the Cloud Run runtime SA
#
# inference_openai_base_url_override = "https://europe-west2-aiplatform.googleapis.com/v1beta1/projects/project-a625d19b-de99-48e9-9a9/locations/europe-west2/endpoints/openapi"
# llm_model                          = "google/gemini-2.5-flash"
# llm_enabled_kinds                  = ""        # "" => prep_brief only; "*" => all four
# grant_vertex_aiplatform_iam        = true
