# Copy to terraform.tfvars (gitignored) for local runs.

project_id   = "project-a625d19b-de99-48e9-9a9"
region       = "europe-west2"
jurisdiction = "uk"
environment  = "dev"
name_prefix  = "sona"

gcs_bucket_force_destroy = true

db_tier                = "db-f1-micro"
db_edition             = "ENTERPRISE" # required for db-f1-micro on POSTGRES_16 (API default is ENTERPRISE_PLUS)
db_disk_size_gb        = 10
db_high_availability   = false
db_deletion_protection = false
db_backup_enabled      = true
db_pitr_enabled        = true

# MVP phase 1: core only (VPC, Cloud SQL, KMS, GCS, Cloud Tasks, Artifact Registry).
inference_enabled = false

# Phase 2 — GKE + vLLM (ADR-003). Enable after core apply succeeds.
# inference_enabled = true
# inference_zone    = "europe-west2-b"
# model_gcs_prefix  = "gemma-3-27b-it"
# vllm_container_image = "europe-west2-docker.pkg.dev/project-a625d19b-de99-48e9-9a9/sona-sona/vllm-openai:latest"
# inference_gpu_machine_type    = "g2-standard-8"
# inference_node_pool_min_count = 1
# inference_node_pool_max_count = 1
# inference_deletion_protection = false

# Postmark (after domain verified + secret version added — see infra/docs/unblock-postmark-and-inference.md)
# postmark_from_email = "noreply@yourdomain.com"
