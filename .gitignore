# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Env and secrets (never commit)
.env
.env.*
!.env.example
# Local MCP overrides (optional; commit .cursor/mcp.json.example, copy to mcp.json)
.cursor/mcp.local.json
# If mcp.json contains inline API keys, use mcp.local.json instead and keep mcp.json env-based only
*.pem
credentials.json
*-credentials.json

# Terraform (see also infra/.gitignore)
**/.terraform/
*.tfstate
*.tfstate.*
**/terraform.tfvars
**/backend.tf
**/backend.hcl
**/backend.ci.hcl
**/ci.auto.tfvars
**/local.auto.tfvars
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Node (API — apps/api)
node_modules/
dist/
build/
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Flutter (apps/sona) — see apps/sona/.gitignore for platform rules
apps/sona/.dart_tool/
apps/sona/.flutter-plugins
apps/sona/.flutter-plugins-dependencies
apps/sona/.packages
apps/sona/.pub-cache/
apps/sona/.pub/
apps/sona/build/
apps/sona/coverage/
apps/sona/**/*.iml
apps/sona/**/generated_plugin_registrant.*
apps/sona/**/generated_plugins.cmake
apps/sona/**/GeneratedPluginRegistrant.*
