apps/sona/**/Flutter/Generated.xcconfig
apps/sona/**/Flutter/flutter_export_environment.sh
apps/sona/android/local.properties
apps/sona/android/.gradle/
apps/sona/android/.cxx/
apps/sona/android/app/debug/
apps/sona/android/app/profile/
apps/sona/android/app/release/
*.g.dart
*.freezed.dart

# Generated API clients
**/openapi-dart/

# Review assets with possible PII (per mvp-brief)
_review/

# Intake PDF screenshots — kept under E:\devup\customer\intake-forms\intake-pdf-pages
docs/intake-pdf-pages/

# Local debug artefacts (e.g. compiled Flutter web bundles fetched for grep/debug)
