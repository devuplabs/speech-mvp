{
  "name": "@sona/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "sync:few-shot": "node scripts/sync-few-shot.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google-cloud/tasks": "^5.5.2",
    "@hono/node-server": "^1.14.4",
    "drizzle-orm": "^0.45.2",
    "firebase-admin": "^12.7.0",
    "google-auth-library": "^9.15.1",
    "hono": "^4.12.29",
    "pg": "^8.22.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "tsx": "^4.23.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.63.0",
    "vitest": "^3.2.7"
  }
}
