{
  "name": "@sona/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google-cloud/tasks": "^5.5.2",
    "@hono/node-server": "^1.14.4",
    "drizzle-orm": "^0.45.2",
    "firebase-admin": "^12.7.0",
    "google-auth-library": "^9.15.1",
    "hono": "^4.12.25",
    "pg": "^8.14.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
